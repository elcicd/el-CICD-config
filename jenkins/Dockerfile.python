ARG JENKINS_OCI_REGISTRY
FROM ${JENKINS_OCI_REGISTRY}/elcicd-jenkins-agent-base

USER root

ARG INSTALL_PKGS="gcc python3-devel"
RUN microdnf install -y --nodocs ${INSTALL_PKGS} && \
    microdnf clean all && \
    mkdir ${HOME}/.cache/pip && \
    chmod 777 ${HOME}/.cache/pip && \
    python3 -m ensurepip --upgrade && \
    python3 -m pip install setuptools wheel bzt virtualenv && \
    rm -f /var/logs/*

USER 1001